// math.zv
//
// Tiny numeric helpers and common constants. Each integer/float width has its
// own min/max/clamp so they work cleanly with ZV's explicit types. Function
// names always include the full width (e.g. min_u64, not min_u).
//
// Constants are written as raw literals instead of expressions like PI/180
// because the current compiler crashes when global float constants reference
// other globals during LLVM optimization.
//
// Examples:
//   #include "lib/math.zv"
//
//   // Constants
//   FLOAT64 circumference = 2.0 * PI * r;
//   FLOAT64 radians = degrees * DEG2RAD;
//   FLOAT64 degrees = radians * RAD2DEG;
//
//   // Integer helpers
//   INT32 a = min_i32(3, 7);               // 3
//   INT32 b = max_i32(3, 7);               // 7
//   INT32 c = clamp_i32(10, 0, 5);         // 5
//   INT32 d = abs_i32(-4);                 // 4
//   INT32 e = sign_i32(-99);               // -1
//
//   // 64-bit variants
//   INT64 x = min_i64(-1, 1);
//   INT64 y = clamp_i64(x, 0, 100);
//   INT64 z = abs_i64(-42);
//   INT64 s = sign_i64(0);                 // 0
//
//   // 128-bit variants
//   INT128 big = clamp_i128(v, lo, hi);
//
//   // Unsigned helpers (no abs/sign)
//   UINT32 u = min_u32(3, 7);
//   UINT64 v = clamp_u64(200, 0, 100);    // 100
//   UINT128 w = max_u128(a, b);
//
//   // Float helpers
//   FLOAT64 f = lerp_f64(0.0, 10.0, 0.5); // 5.0
//   FLOAT64 g = clamp_f64(PI, 0.0, 1.0);  // 1.0
//   FLOAT32 h = sign_f32(-2.5);           // -1.0
//   FLOAT32 i = abs_f32(-3.5);           // 3.5
//
//   // Conversions and angle units
//   INT32 deg = round_i32(rad2deg_f64(PI)); // 180
//   FLOAT64 rad = deg2rad_f64(180.0);       // PI
//   INT32 n = round_i32(3.7);              // 4
//   INT64 m = floor_i64(3.9);              // 3
//   INT64 o = ceil_i64(3.1);               // 4

CONST FLOAT64 PI      = 3.14159265358979323846;
CONST FLOAT64 TAU     = 6.28318530717958647692;
CONST FLOAT64 E       = 2.71828182845904523536;
CONST FLOAT64 DEG2RAD = 0.01745329251994329576;
CONST FLOAT64 RAD2DEG = 57.2957795130823208768;

// --- INT32 -------------------------------------------------------------------

INT32 min_i32(INT32 a, INT32 b) { return (a < b) ? a : b; }
INT32 max_i32(INT32 a, INT32 b) { return (a > b) ? a : b; }
INT32 clamp_i32(INT32 v, INT32 lo, INT32 hi) { return max_i32(lo, min_i32(hi, v)); }
INT32 abs_i32(INT32 x) { return (x < 0) ? -x : x; }
INT32 sign_i32(INT32 x) { if (x > 0) return 1; if (x < 0) return -1; return 0; }

// --- INT64 -------------------------------------------------------------------

INT64 min_i64(INT64 a, INT64 b) { return (a < b) ? a : b; }
INT64 max_i64(INT64 a, INT64 b) { return (a > b) ? a : b; }
INT64 clamp_i64(INT64 v, INT64 lo, INT64 hi) { return max_i64(lo, min_i64(hi, v)); }
INT64 abs_i64(INT64 x) { return (x < 0) ? -x : x; }
INT64 sign_i64(INT64 x) { if (x > 0) return 1 as INT64; if (x < 0) return -1 as INT64; return 0 as INT64; }

// --- INT128 ------------------------------------------------------------------

INT128 min_i128(INT128 a, INT128 b) { return (a < b) ? a : b; }
INT128 max_i128(INT128 a, INT128 b) { return (a > b) ? a : b; }
INT128 clamp_i128(INT128 v, INT128 lo, INT128 hi) { return max_i128(lo, min_i128(hi, v)); }
INT128 abs_i128(INT128 x) { return (x < 0) ? -x : x; }
INT128 sign_i128(INT128 x) { if (x > 0) return 1 as INT128; if (x < 0) return -1 as INT128; return 0 as INT128; }

// --- UINT32 ------------------------------------------------------------------

UINT32 min_u32(UINT32 a, UINT32 b) { return (a < b) ? a : b; }
UINT32 max_u32(UINT32 a, UINT32 b) { return (a > b) ? a : b; }
UINT32 clamp_u32(UINT32 v, UINT32 lo, UINT32 hi) { return max_u32(lo, min_u32(hi, v)); }

// --- UINT64 ------------------------------------------------------------------

UINT64 min_u64(UINT64 a, UINT64 b) { return (a < b) ? a : b; }
UINT64 max_u64(UINT64 a, UINT64 b) { return (a > b) ? a : b; }
UINT64 clamp_u64(UINT64 v, UINT64 lo, UINT64 hi) { return max_u64(lo, min_u64(hi, v)); }

// --- UINT128 -----------------------------------------------------------------

UINT128 min_u128(UINT128 a, UINT128 b) { return (a < b) ? a : b; }
UINT128 max_u128(UINT128 a, UINT128 b) { return (a > b) ? a : b; }
UINT128 clamp_u128(UINT128 v, UINT128 lo, UINT128 hi) { return max_u128(lo, min_u128(hi, v)); }

// --- FLOAT32 -----------------------------------------------------------------

FLOAT32 min_f32(FLOAT32 a, FLOAT32 b) { return (a < b) ? a : b; }
FLOAT32 max_f32(FLOAT32 a, FLOAT32 b) { return (a > b) ? a : b; }
FLOAT32 clamp_f32(FLOAT32 v, FLOAT32 lo, FLOAT32 hi) { return max_f32(lo, min_f32(hi, v)); }
FLOAT32 abs_f32(FLOAT32 x) { return (x < 0.0) ? -x : x; }
FLOAT32 sign_f32(FLOAT32 x) { if (x > 0.0) return 1.0 as FLOAT32; if (x < 0.0) return -1.0 as FLOAT32; return 0.0 as FLOAT32; }
FLOAT32 lerp_f32(FLOAT32 a, FLOAT32 b, FLOAT32 t) { return (a + (b - a) * t) as FLOAT32; }

// --- FLOAT64 -----------------------------------------------------------------

FLOAT64 min_f64(FLOAT64 a, FLOAT64 b) { return (a < b) ? a : b; }
FLOAT64 max_f64(FLOAT64 a, FLOAT64 b) { return (a > b) ? a : b; }
FLOAT64 clamp_f64(FLOAT64 v, FLOAT64 lo, FLOAT64 hi) { return max_f64(lo, min_f64(hi, v)); }
FLOAT64 abs_f64(FLOAT64 x) { return (x < 0.0) ? -x : x; }
FLOAT64 sign_f64(FLOAT64 x) { if (x > 0.0) return 1.0; if (x < 0.0) return -1.0; return 0.0; }
FLOAT64 lerp_f64(FLOAT64 a, FLOAT64 b, FLOAT64 t) { return a + (b - a) * t; }

// --- mixed helpers -----------------------------------------------------------

INT32 floor_i32(FLOAT32 x) { return x as INT32; }
INT32 ceil_i32(FLOAT32 x) { return (x + 0.99999994 as FLOAT32) as INT32; }
INT32 round_i32(FLOAT32 x) { return (x + 0.5 as FLOAT32) as INT32; }

INT64 floor_i64(FLOAT64 x) { return x as INT64; }
INT64 ceil_i64(FLOAT64 x) { return (x + 0.9999999999999999) as INT64; }
INT64 round_i64(FLOAT64 x) { return (x + 0.5) as INT64; }

FLOAT32 deg2rad_f32(FLOAT32 d) { return d * DEG2RAD as FLOAT32; }
FLOAT32 rad2deg_f32(FLOAT32 r) { return r * RAD2DEG as FLOAT32; }

FLOAT64 deg2rad_f64(FLOAT64 d) { return d * DEG2RAD; }
FLOAT64 rad2deg_f64(FLOAT64 r) { return r * RAD2DEG; }
