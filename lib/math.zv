// math.zv
//
// Tiny numeric helpers and common constants. Each integer/float width has its
// own min/max/clamp so they work cleanly with ZV's explicit types.
//
// Constants are written as raw literals instead of expressions like PI/180
// because the current compiler crashes when global float constants reference
// other globals during LLVM optimization.

CONST FLOAT64 PI      = 3.14159265358979323846;
CONST FLOAT64 TAU     = 6.28318530717958647692;
CONST FLOAT64 E       = 2.71828182845904523536;
CONST FLOAT64 DEG2RAD = 0.01745329251994329576;
CONST FLOAT64 RAD2DEG = 57.2957795130823208768;

// --- INT32 -------------------------------------------------------------------

INT32 min_i32(INT32 a, INT32 b) { return (a < b) ? a : b; }
INT32 max_i32(INT32 a, INT32 b) { return (a > b) ? a : b; }
INT32 clamp_i32(INT32 v, INT32 lo, INT32 hi) { return max_i32(lo, min_i32(hi, v)); }
INT32 abs_i32(INT32 x) { return (x < 0) ? -x : x; }
INT32 sign_i32(INT32 x) { if (x > 0) return 1; if (x < 0) return -1; return 0; }

// --- INT64 -------------------------------------------------------------------

INT64 min_i(INT64 a, INT64 b) { return (a < b) ? a : b; }
INT64 max_i(INT64 a, INT64 b) { return (a > b) ? a : b; }
INT64 clamp_i(INT64 v, INT64 lo, INT64 hi) { return max_i(lo, min_i(hi, v)); }
INT64 abs_i(INT64 x) { return (x < 0) ? -x : x; }
INT64 sign_i(INT64 x) { if (x > 0) return 1 as INT64; if (x < 0) return -1 as INT64; return 0 as INT64; }

// --- INT128 ------------------------------------------------------------------

INT128 min_i128(INT128 a, INT128 b) { return (a < b) ? a : b; }
INT128 max_i128(INT128 a, INT128 b) { return (a > b) ? a : b; }
INT128 clamp_i128(INT128 v, INT128 lo, INT128 hi) { return max_i128(lo, min_i128(hi, v)); }
INT128 abs_i128(INT128 x) { return (x < 0) ? -x : x; }
INT128 sign_i128(INT128 x) { if (x > 0) return 1 as INT128; if (x < 0) return -1 as INT128; return 0 as INT128; }

// --- UINT32 ------------------------------------------------------------------

UINT32 min_u32(UINT32 a, UINT32 b) { return (a < b) ? a : b; }
UINT32 max_u32(UINT32 a, UINT32 b) { return (a > b) ? a : b; }
UINT32 clamp_u32(UINT32 v, UINT32 lo, UINT32 hi) { return max_u32(lo, min_u32(hi, v)); }

// --- UINT64 ------------------------------------------------------------------

UINT64 min_u(UINT64 a, UINT64 b) { return (a < b) ? a : b; }
UINT64 max_u(UINT64 a, UINT64 b) { return (a > b) ? a : b; }
UINT64 clamp_u(UINT64 v, UINT64 lo, UINT64 hi) { return max_u(lo, min_u(hi, v)); }

// --- UINT128 -----------------------------------------------------------------

UINT128 min_u128(UINT128 a, UINT128 b) { return (a < b) ? a : b; }
UINT128 max_u128(UINT128 a, UINT128 b) { return (a > b) ? a : b; }
UINT128 clamp_u128(UINT128 v, UINT128 lo, UINT128 hi) { return max_u128(lo, min_u128(hi, v)); }

// --- FLOAT32 -----------------------------------------------------------------

FLOAT32 min_f32(FLOAT32 a, FLOAT32 b) { return (a < b) ? a : b; }
FLOAT32 max_f32(FLOAT32 a, FLOAT32 b) { return (a > b) ? a : b; }
FLOAT32 clamp_f32(FLOAT32 v, FLOAT32 lo, FLOAT32 hi) { return max_f32(lo, min_f32(hi, v)); }
FLOAT32 abs_f32(FLOAT32 x) { return (x < 0.0) ? -x : x; }
FLOAT32 sign_f32(FLOAT32 x) { if (x > 0.0) return 1.0 as FLOAT32; if (x < 0.0) return -1.0 as FLOAT32; return 0.0 as FLOAT32; }
FLOAT32 lerp_f32(FLOAT32 a, FLOAT32 b, FLOAT32 t) { return (a + (b - a) * t) as FLOAT32; }

// --- FLOAT64 -----------------------------------------------------------------

FLOAT64 min_f(FLOAT64 a, FLOAT64 b) { return (a < b) ? a : b; }
FLOAT64 max_f(FLOAT64 a, FLOAT64 b) { return (a > b) ? a : b; }
FLOAT64 clamp_f(FLOAT64 v, FLOAT64 lo, FLOAT64 hi) { return max_f(lo, min_f(hi, v)); }
FLOAT64 abs_f(FLOAT64 x) { return (x < 0.0) ? -x : x; }
FLOAT64 sign_f(FLOAT64 x) { if (x > 0.0) return 1.0; if (x < 0.0) return -1.0; return 0.0; }
FLOAT64 lerp(FLOAT64 a, FLOAT64 b, FLOAT64 t) { return a + (b - a) * t; }

// --- mixed helpers -----------------------------------------------------------

INT64 floor_i(FLOAT64 x) { return x as INT64; }
INT64 ceil_i(FLOAT64 x) { return (x + 0.9999999999999999) as INT64; }
INT64 round_i(FLOAT64 x) { return (x + 0.5) as INT64; }

FLOAT64 deg2rad(FLOAT64 d) { return d * DEG2RAD; }
FLOAT64 rad2deg(FLOAT64 r) { return r * RAD2DEG; }
