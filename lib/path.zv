// path.zv
//
// Tiny path helpers. All results are owned CSTRINGs that are freed automatically
// when bound to a CSTRING variable.
//
// Examples:
//   #include <lib/path.zv>
//
//   CSTRING p = "C:\\foo\\bar\\baz.txt";
//   print("dir: %s", path_dir(p));      // C:\foo\bar
//   print("file: %s", path_file(p));     // baz.txt
//   print("ext: %s", path_ext(p));      // txt
//
//   // Standard aliases
//   print("dir: %s", dirname(p));
//   print("file: %s", basename(p));
//   print("ext: %s", extname(p));
//
//   print("joined: %s", join("a", "b"));            // a/b
//   print("joined: %s", path_join("a/", "b"));     // a/b
//   print("absolute? %d", is_absolute(p));
//   print("normalized: %s", normalize("/a/b/../c//d/./e")); // /a/c/d/e

BOOL __path_is_sep(INT8 c) {
    return c == '/' || c == '\\';
}

// Allocate a copy of n bytes from s starting at off.
CSTRING __path_slice(CSTRING s, INT64 off, INT64 n) {
    if (n < 0) n = 0;
    PTR<INT8> p = alloc((n + 1) as INT64) as PTR<INT8>;
    unsafe {
        INT64 i = 0;
        while (i < n) {
            p[i] = s[off + i];
            i = i + 1;
        }
        p[n] = 0;
    }
    return move(p) as CSTRING;
}

// Allocate a fresh copy of s.
CSTRING __path_copy(CSTRING s) {
    INT64 n = strlen(s);
    PTR<INT8> p = alloc((n + 1) as INT64) as PTR<INT8>;
    unsafe { strcpy(p, s); }
    return move(p) as CSTRING;
}

// Concatenate a and b into a fresh CSTRING.
CSTRING __path_cat(CSTRING a, CSTRING b) {
    INT64 al = strlen(a);
    INT64 bl = strlen(b);
    PTR<INT8> p = alloc((al + bl + 1) as INT64) as PTR<INT8>;
    unsafe {
        strcpy(p, a);
        strcat(p, b);
    }
    return move(p) as CSTRING;
}

// Join two path components, inserting a separator only when needed.
CSTRING path_join(CSTRING a, CSTRING b) {
    INT64 al = strlen(a);
    INT64 bl = strlen(b);

    BOOL a_sep = false;
    BOOL b_sep = false;
    unsafe {
        if (al > 0) {
            a_sep = __path_is_sep(a[al - 1]);
        }
        if (bl > 0) {
            b_sep = __path_is_sep(b[0]);
        }
    }

    if (a_sep || b_sep) {
        return __path_cat(a, b);
    }

    CSTRING tmp = __path_cat(a, "/");
    CSTRING result = __path_cat(tmp, b);
    free(tmp);
    return result;
}

// Return the directory portion of a path ("." if there is no separator).
CSTRING path_dir(CSTRING p) {
    INT64 n = strlen(p);
    INT64 i = n - 1;
    unsafe {
        while (i >= 0) {
            if (__path_is_sep(p[i])) {
                break;
            }
            i = i - 1;
        }
    }
    if (i < 0) {
        return __path_copy(".");
    }
    return __path_slice(p, 0, i);
}

// Return the file name portion of a path.
CSTRING path_file(CSTRING p) {
    INT64 n = strlen(p);
    INT64 i = n - 1;
    unsafe {
        while (i >= 0) {
            if (__path_is_sep(p[i])) {
                break;
            }
            i = i - 1;
        }
    }
    if (i < 0) {
        return __path_copy(p);
    }
    return __path_slice(p, i + 1, n - i - 1);
}

// Return the extension of a path (empty string if none).
CSTRING path_ext(CSTRING p) {
    INT64 n = strlen(p);
    INT64 dot = -1;
    INT64 sep = -1;
    unsafe {
        INT64 i = n - 1;
        while (i >= 0) {
            INT8 c = p[i];
            if (c == '.') {
                if (dot < 0) {
                    dot = i;
                }
            } else if (__path_is_sep(c)) {
                sep = i;
                break;
            }
            i = i - 1;
        }
    }
    if (dot < 0 || dot <= sep) {
        return __path_slice(p, 0, 0);
    }
    return __path_slice(p, dot + 1, n - dot - 1);
}

// Standard aliases for the path helpers above.
CSTRING dirname(CSTRING p) { return path_dir(p); }
CSTRING basename(CSTRING p) { return path_file(p); }
CSTRING extname(CSTRING p) { return path_ext(p); }
CSTRING join(CSTRING a, CSTRING b) { return path_join(a, b); }

// Return true if the path is absolute.
// Recognizes POSIX leading '/', Windows drive letters ("C:\" / "C:/"),
// and Windows UNC paths ("\\\\server\\share").
BOOL is_absolute(CSTRING p) {
    INT64 n = strlen(p);
    unsafe {
        if (n == 0) {
            return false;
        }
        if (__path_is_sep(p[0])) {
            return true;
        }
        if (n >= 3 && p[1] == ':' && __path_is_sep(p[2])) {
            return true;
        }
    }
    return false;
}

// Normalize a path: collapse duplicate separators, resolve "." and "..",
// and return an owned CSTRING. The result uses '/' separators.
// Does not access the filesystem, so symlinks are not resolved.
CSTRING normalize(CSTRING p) {
    INT64 n = strlen(p);

    PTR<INT8> out = alloc((n + 1) as INT64) as PTR<INT8>;
    PTR<INT8> tmp = alloc((n + 1) as INT64) as PTR<INT8>;

    // Track component offsets in 'out' with a simple stack of (start, length).
    INT64 max_comps = n + 2;
    PTR<INT64> starts = alloc(max_comps * 8) as PTR<INT64>;
    PTR<INT64> lens = alloc(max_comps * 8) as PTR<INT64>;
    INT64 comp_count = 0;

    INT64 i = 0;
    INT64 out_pos = 0;
    BOOL had_leading_sep = false;
    INT64 drive_len = 0;

    unsafe {
        // Preserve a Windows drive letter prefix (e.g. "C:").
        if (n >= 2 && p[1] == ':') {
            out[0] = p[0];
            out[1] = ':';
            out_pos = 2;
            drive_len = 2;
            i = 2;
            // Treat "C:/" as absolute and skip the separator so we emit a single '/' later.
            if (i < n && __path_is_sep(p[i])) {
                had_leading_sep = true;
                i = i + 1;
            }
        } else if (n > 0 && __path_is_sep(p[0])) {
            had_leading_sep = true;
            i = 1;
        }

        while (i <= n) {
            // Find the next separator or end of string.
            INT64 start = i;
            while (i < n && !__path_is_sep(p[i])) {
                i = i + 1;
            }
            INT64 len = i - start;

            // Classify component.
            if (len == 0 || (len == 1 && p[start] == '.')) {
                // empty or "." -> skip
            } else if (len == 2 && p[start] == '.' && p[start + 1] == '.') {
                // ".." -> pop previous component if possible
                if (comp_count > 0) {
                    comp_count = comp_count - 1;
                }
            } else {
                starts[comp_count] = start;
                lens[comp_count] = len;
                comp_count = comp_count + 1;
            }

            // Skip the separator.
            if (i < n) {
                i = i + 1;
            } else {
                i = i + 1;
                break;
            }
        }

        // Reconstruct.
        INT64 write = drive_len;
        if (had_leading_sep) {
            out[write] = '/';
            write = write + 1;
        }
        INT64 c = 0;
        while (c < comp_count) {
            INT64 s = starts[c];
            INT64 l = lens[c];
            INT64 k = 0;
            while (k < l) {
                out[write] = p[s + k];
                write = write + 1;
                k = k + 1;
            }
            if (c + 1 < comp_count) {
                out[write] = '/';
                write = write + 1;
            }
            c = c + 1;
        }
        if (write == drive_len && !had_leading_sep) {
            // Relative path collapsed to nothing -> "./"
            out[write] = '.';
            write = write + 1;
        }
        out[write] = 0;
    }

    CSTRING result = move(out) as CSTRING;
    free(tmp as PTR<VOID>);
    free(starts as PTR<VOID>);
    free(lens as PTR<VOID>);
    return result;
}
