// Macro functions extracted from header
WPARAM MAKEWPARAM(UINT16 a, UINT16 b) {
    return (((a as UINT_PTR) << 16) | (b as UINT_PTR)) as WPARAM;
}
LPARAM MAKELPARAM(UINT16 a, UINT16 b) {
    return (((a as INT_PTR) << 16) | (b as INT_PTR)) as LPARAM;
}
LRESULT MAKELRESULT(UINT16 a, UINT16 b) {
    return (((a as INT_PTR) << 16) | (b as INT_PTR)) as LRESULT;
}

