// libc_errno.zv
//
// ZV bindings for glibc `errno` access and error-string helpers (<errno.h>,
// <string.h>). ZV `extern` blocks only support functions, not raw external
// variables, so `errno` is read through glibc's `__errno_location()`
// accessor, which returns a pointer to the calling thread's errno value.
// Reading through a raw pointer requires an `unsafe { }` block:
//
//   INT32 e;
//   unsafe { e = __errno_location()[0]; }

#include "types.zv"

// --- errno.h common values (Linux x86_64) ------------------------------------
#define EPERM   1
#define ENOENT  2
#define ESRCH   3
#define EINTR   4
#define EIO     5
#define ENXIO   6
#define EBADF   9
#define EAGAIN  11
#define ENOMEM  12
#define EACCES  13
#define EFAULT  14
#define EBUSY   16
#define EEXIST  17
#define ENOTDIR 20
#define EISDIR  21
#define EINVAL  22
#define ENFILE  23
#define EMFILE  24
#define ENOSPC  28
#define EPIPE   32
#define ECONNREFUSED 111
#define ETIMEDOUT    110
#define EWOULDBLOCK  EAGAIN

extern "" {
    PTR<INT32> __errno_location();
    CSTRING strerror(INT32 errnum);
    INT32 strerror_r(INT32 errnum, CSTRING buf, SIZE_T buflen);
}
