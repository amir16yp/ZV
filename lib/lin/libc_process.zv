// libc_process.zv
//
// ZV bindings for POSIX process control (<unistd.h>, <sys/wait.h>,
// <stdlib.h>).

#include "types.zv"

// --- sys/wait.h options --------------------------------------------------
#define WNOHANG 1
#define WUNTRACED 2

extern "" {
    pid_t fork();
    pid_t vfork();
    INT32 execv(CSTRING path, PTR<CSTRING> argv);
    INT32 execvp(CSTRING file, PTR<CSTRING> argv);
    INT32 execve(CSTRING path, PTR<CSTRING> argv, PTR<CSTRING> envp);
    INT32 execl(CSTRING path, CSTRING arg0, PTR<VOID> arglist);
    VOID exit(INT32 status);
    VOID _exit(INT32 status);
    pid_t getpid();
    pid_t getppid();
    pid_t getpgid(pid_t pid);
    INT32 setpgid(pid_t pid, pid_t pgid);
    uid_t getuid();
    uid_t geteuid();
    gid_t getgid();
    gid_t getegid();
    INT32 setuid(uid_t uid);
    INT32 setgid(gid_t gid);
    pid_t waitpid(pid_t pid, PTR<INT32> wstatus, INT32 options);
    pid_t wait(PTR<INT32> wstatus);
    INT32 kill(pid_t pid, INT32 sig);
    UINT32 alarm(UINT32 seconds);
    UINT32 sleep(UINT32 seconds);
    INT32 usleep(UINT32 usec);
    INT32 system(CSTRING command);
    CSTRING getenv(CSTRING name);
    INT32 setenv(CSTRING name, CSTRING value, INT32 overwrite);
    INT32 unsetenv(CSTRING name);
    INT32 putenv(CSTRING string_value);
}
