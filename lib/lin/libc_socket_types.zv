// libc_socket_types.zv
//
// Constants for the POSIX sockets API (<sys/socket.h>, <netinet/in.h>).
// Values are Linux x86_64 specific.

#include "types.zv"

// --- sys/socket.h address families -------------------------------------
#define AF_UNSPEC 0
#define AF_UNIX   1
#define AF_LOCAL  1
#define AF_INET   2
#define AF_INET6  10

// --- sys/socket.h socket types -------------------------------------------
#define SOCK_STREAM 1
#define SOCK_DGRAM  2
#define SOCK_RAW    3
#define SOCK_NONBLOCK 0x800
#define SOCK_CLOEXEC  0x80000

// --- sys/socket.h protocol / option levels -------------------------------
#define IPPROTO_TCP 6
#define IPPROTO_UDP 17
#define IPPROTO_IP  0
#define SOL_SOCKET  1

// --- sys/socket.h socket options -----------------------------------------
#define SO_REUSEADDR 2
#define SO_REUSEPORT 15
#define SO_KEEPALIVE 9
#define SO_BROADCAST 6
#define SO_LINGER    13
#define SO_RCVTIMEO  20
#define SO_SNDTIMEO  21
#define SO_ERROR     4

// --- sys/socket.h shutdown() how values -----------------------------------
#define SHUT_RD   0
#define SHUT_WR   1
#define SHUT_RDWR 2

// --- sys/socket.h send/recv flags -----------------------------------------
#define MSG_NOSIGNAL 0x4000
#define MSG_WAITALL  0x100
#define MSG_PEEK     0x2

// INADDR_ANY / INADDR_LOOPBACK, in network byte order as 32-bit values.
#define INADDR_ANY 0x00000000
#define INADDR_LOOPBACK 0x7F000001
