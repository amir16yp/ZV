// libc_mem.zv
//
// ZV bindings for POSIX/C memory management (<stdlib.h>, <sys/mman.h>).
//
// Note: `free` is a ZV keyword/builtin (it already calls libc's `free()`
// directly), so it is not re-declared here — just call the built-in
// `free(ptr)` on pointers returned by `malloc`/`calloc`/`realloc` below.

#include "types.zv"

// --- sys/mman.h prot flags -----------------------------------------------
#define PROT_NONE  0x0
#define PROT_READ  0x1
#define PROT_WRITE 0x2
#define PROT_EXEC  0x4

// --- sys/mman.h map flags -------------------------------------------------
#define MAP_SHARED    0x01
#define MAP_PRIVATE   0x02
#define MAP_FIXED     0x10
#define MAP_ANONYMOUS 0x20
#define MAP_FAILED_VALUE -1

extern "" {
    PTR<VOID> malloc(SIZE_T size);
    PTR<VOID> calloc(SIZE_T nmemb, SIZE_T size);
    PTR<VOID> realloc(PTR<VOID> ptr, SIZE_T size);
    PTR<VOID> mmap(PTR<VOID> addr, SIZE_T length, INT32 prot, INT32 flags, INT32 fd, off_t offset);
    INT32 munmap(PTR<VOID> addr, SIZE_T length);
    INT32 mprotect(PTR<VOID> addr, SIZE_T length, INT32 prot);
    INT32 msync(PTR<VOID> addr, SIZE_T length, INT32 flags);
    INT32 brk(PTR<VOID> addr);
    PTR<VOID> sbrk(INT64 increment);
    PTR<VOID> memcpy(PTR<VOID> dest, PTR<VOID> src, SIZE_T n);
    PTR<VOID> memmove(PTR<VOID> dest, PTR<VOID> src, SIZE_T n);
    PTR<VOID> memset(PTR<VOID> s, INT32 c, SIZE_T n);
}
