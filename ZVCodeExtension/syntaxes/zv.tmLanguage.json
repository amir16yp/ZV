{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "ZV",
    "scopeName": "source.zv",
    "fileTypes": [
        ".zv"
    ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#preprocessor"
        },
        {
            "include": "#type-aliases"
        },
        {
            "include": "#exception-decl"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#characters"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.zv",
                    "begin": "/\\*",
                    "end": "\\*/"
                },
                {
                    "name": "comment.line.double-slash.zv",
                    "begin": "//",
                    "end": "$"
                }
            ]
        },
        "preprocessor": {
            "patterns": [
                {
                    "name": "meta.preprocessor.include.zv",
                    "begin": "(#include)\\b",
                    "end": "$",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.directive.include.zv"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#strings"
                        }
                    ]
                },
                {
                    "name": "meta.preprocessor.define.zv",
                    "begin": "(#define)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "end": "$",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.directive.define.zv"
                        },
                        "2": {
                            "name": "entity.name.function.preprocessor.zv"
                        }
                    }
                }
            ]
        },
        "type-aliases": {
            "patterns": [
                {
                    "name": "meta.type-alias.zv",
                    "match": "\\b(type|newtype)\\b\\s+\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "2": {
                            "name": "entity.name.type.zv"
                        }
                    }
                }
            ]
        },
        "exception-decl": {
            "patterns": [
                {
                    "name": "meta.exception-decl.zv",
                    "match": "\\b(exception)\\b\\s+\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "2": {
                            "name": "entity.name.type.exception.zv"
                        }
                    }
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.zv",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.zv",
                    "match": "\\\\."
                }
            ]
        },
        "characters": {
            "name": "string.quoted.single.zv",
            "begin": "'",
            "end": "'",
            "patterns": [
                {
                    "name": "constant.character.escape.zv",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.zv",
                    "match": "\\b0[xX][0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.float.zv",
                    "match": "\\b\\d+\\.\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.zv",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.zv",
                    "match": "\\b(if|else|while|for|return|break|continue|try|catch|throw|unsafe)\\b"
                },
                {
                    "name": "keyword.other.zv",
                    "match": "\\b(struct|packed|extern|export|type|newtype|exception|const|free|as|null|true|false)\\b"
                },
                {
                    "name": "keyword.directive.zv",
                    "match": "#(include|define)\\b"
                },
                {
                    "name": "keyword.annotation.zv",
                    "match": "@(entry|export|packed)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.zv",
                    "match": "\\b(VOID|BOOL|CHAR|INT8|INT16|INT32|INT64|INT128|UINT8|UINT16|UINT32|UINT64|UINT128|FLOAT32|FLOAT64|STRING|CSTRING|PTR|EXCEPTION|PROCESS)\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.zv",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.zv",
                    "match": "\\+|-\\*|/|%|==|!=|<=|>=|<|>|&&|\\|\\||!|&|\\||\\^|~|="
                }
            ]
        }
    }
}
